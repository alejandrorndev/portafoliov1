# Copiar a .env.local y rellenar. Nunca commitear .env.local.
#
# Nada de esto hace falta hasta la Fase 6 (formulario de contacto).
# El sitio arranca y compila sin ninguna de estas variables.

# URL publica del sitio. La usan la metadata canonica, el sitemap y las
# imagenes Open Graph. En local dejar el valor de abajo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web3Forms — envio del formulario de contacto, desde el navegador.
# La access key es publica por diseño (solo permite enviar correos al buzon
# del dueño), de ahi el prefijo NEXT_PUBLIC_. Se obtiene en web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Upstash Redis — rate limit del formulario.
# En serverless no sirve estado en memoria: cada invocacion arranca limpia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
